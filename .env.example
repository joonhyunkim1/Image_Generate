# ===== 이미지 생성 API 키 =====
# 웹 화면의 "초기 설정" 메뉴에서 입력하면 이 파일(.env)에 자동 저장됩니다.
# 사용할 제공사 키만 입력하면 됩니다. (키가 없는 제공사의 모델은 선택할 수 없습니다)

# OpenAI: GPT Image 2.5 Sunburst / Flare, GPT Image 2   → https://platform.openai.com/api-keys
OPENAI_API_KEY=
# (선택) OpenAI 공식 청구 금액 조회용 Admin Key         → https://platform.openai.com/settings/organization/admin-keys
OPENAI_ADMIN_KEY=

# Google AI Studio: Nano Banana 2                        → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Black Forest Labs: FLUX.2 Max / Pro / Flex             → https://dashboard.bfl.ai
BFL_API_KEY=

# ===== 저장 / 비용 표시 =====
# 저장 형식: png (기본) | jpg
OUTPUT_FORMAT=png
USD_KRW=1400
# 월 예산(USD). 0이면 표시 안 함. 초과하면 사이드바 금액이 빨갛게 표시
MONTHLY_BUDGET_USD=20

# ===== 기타 =====
# true면 API를 호출하지 않고 가짜 이미지로 화면만 체험할 수 있습니다 (요금 없음)
DEMO_MODE=false
HOST=127.0.0.1
PORT=8100
